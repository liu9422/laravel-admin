{
    "name": "liu9422/laravel-admin",
    "description": "laravel admin (liu9422 fork, based on encore/laravel-admin)",
    "type": "library",
    "version": "1.8.99",
    "keywords": ["laravel", "admin", "grid", "form"],
    "license": "MIT",
    "authors": [
        {
            "name": "liu9422"
        }
    ],
    "replace": {
        "encore/laravel-admin": "self.version"
    },
    "archive": {
        "exclude": [
            "auth.json",
            "composer.lock",
            "vendor",
            ".git"
        ]
    },
    "require": {
        "php": ">=8.2.0",
        "symfony/dom-crawler": "~3.1|~4.0|~5.0|~6.0|~7.0",
        "laravel/framework": ">=11.0"
    },
    "autoload": {
        "psr-4": {
            "Encore\\Admin\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "suggest": {
        "intervention/image": "Required to handling and manipulation upload images (~2.3).",
        "spatie/eloquent-sortable": "Required to built orderable gird."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Encore\\Admin\\AdminServiceProvider"
            ],
            "aliases": {
                "Admin": "Encore\\Admin\\Facades\\Admin"
            }
        }
    }
}
